# OpenAI API key (server-side only)
OPENAI_API_KEY=sk-your-key-here

# Optional: override the model
OPENAI_MODEL=gpt-4o-mini

# Set to "true" only if the app runs behind a trusted reverse proxy
# (e.g. Vercel, Cloudflare, nginx) that overwrites the X-Forwarded-For
# header. If false (default), the rate limit ignores client-supplied
# IPs and falls back to a single global bucket.
TRUST_PROXY=false
